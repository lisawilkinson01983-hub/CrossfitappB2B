{
  "name": "crossfit-community-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:railway": "prisma db push --accept-data-loss && node scripts/backfill-gym-pages.js && node scripts/backfill-events.js && node scripts/backfill-admin.js && node scripts/backfill-event-notifications.js && node scripts/backfill-onboarding-seen.js && next start -p $PORT",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "media:migrate": "node scripts/migrate-media-to-bucket.js",
    "media:cleanup": "node scripts/cleanup-orphan-media.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1139.0",
    "@aws-sdk/s3-request-presigner": "3.1139.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "ffmpeg-static": "5.3.0",
    "next": "15.5.23",
    "next-auth": "4.24.15",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "0.35.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.10.10",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3"
  }
}
