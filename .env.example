DATABASE_URL="file:./dev.db"

# Generate a real secret for any non-local use, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET="dev-only-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# Uploaded media storage (see docs/media-storage.md). Leave MEDIA_BUCKET
# unset to store uploads on local disk (UPLOADS_DIR, default ./uploads).
# UPLOADS_DIR="/data/uploads"
# MEDIA_BUCKET=""
# MEDIA_S3_ENDPOINT=""
# MEDIA_S3_REGION="auto"
# MEDIA_S3_ACCESS_KEY_ID=""
# MEDIA_S3_SECRET_ACCESS_KEY=""
# Only for a publicly readable bucket behind a CDN/custom domain (e.g. R2):
# MEDIA_PUBLIC_URL="https://media.example.com"
# Only if your provider needs path-style URLs:
# MEDIA_S3_FORCE_PATH_STYLE="true"
