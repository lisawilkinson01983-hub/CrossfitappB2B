DATABASE_URL="file:./dev.db"

# Optional: where uploaded photos/videos are written. Defaults to a plain
# "uploads" folder next to the app, which is fine locally but NOT persistent
# in production — on Railway, point this at a mounted volume (e.g.
# "/data/uploads"), the same way DATABASE_URL should point at that volume too
# (e.g. "file:/data/app.db") rather than the default above.
UPLOADS_DIR=""

# Generate a real secret for any non-local use, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET="dev-only-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# Optional: sends verification/password-reset emails through Brevo's HTTPS
# API — use this on Railway's Hobby plan, which blocks outbound SMTP. The API
# key is under Brevo → SMTP & API → API Keys (not the SMTP key).
BREVO_API_KEY=""
EMAIL_FROM="Box 2 Box <you@example.com>"

# Optional: sends verification/password-reset emails via SMTP instead. Without these
# set, emails are just logged to the console (fine for local dev, not for
# real users) — works with any provider (Gmail, SendGrid, Postmark, Resend's
# SMTP, SES, etc.).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional: error monitoring. Create a free project at sentry.io and put its
# DSN here (both — SENTRY_DSN for server-side errors, NEXT_PUBLIC_SENTRY_DSN
# for client-side ones) to turn it on; leave unset to skip it entirely.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Optional: set to "true" to require an existing member's invite code at
# signup (each member's code is in Settings → Invite Friends). Use this
# instead of SITE_PASSWORD once the app is being installed to home screens.
INVITE_ONLY=""

# Optional: nightly off-Railway backup of the database + uploaded media (see
# src/app/api/admin/cron/backup/route.ts) to a Cloudflare R2 bucket, since
# Railway's own volume backups need the Pro plan. Leave unset to skip it
# entirely — the /api/admin/backup download button in Settings still works
# without any of this. BACKUP_SECRET is a random string you generate (e.g.
# `openssl rand -hex 32`) and also put in the Authorization header of
# whatever calls this route on a schedule (a Railway Cron Job). The R2_*
# values come from a Cloudflare R2 bucket + API token.
BACKUP_SECRET=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Optional: the email of an existing account to use as the app's own "Box 2
# Box" identity — every new signup auto-follows it (MySpace-Tom style, see
# addWelcomeFriend in /api/signup), and it's the sender shown on admin
# broadcast notices (Settings → Admin → Send a notice, see
# src/lib/siteAccount.ts). Leave unset to skip both.
ADMIN_USER_EMAIL=""
