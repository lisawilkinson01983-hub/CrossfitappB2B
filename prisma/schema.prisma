generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Level {
  SCALED
  INTERMEDIATE
  RX
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_DISCLOSE
}

// SQLite has no native array type, so `lookingFor` is stored as a
// JSON-encoded array of these values (see src/lib/lookingFor.ts).
enum LookingFor {
  TEAM_MATES
  FRIENDS
  DEEPER_CONNECTION
}

enum WorkoutUnit {
  TIME
  REPS
  WEIGHT
}

// A per-workout Rx/Scaled call, distinct from the athlete's overall Level
// (which also allows INTERMEDIATE) — a single WOD is only ever Rx'd or scaled.
enum WorkoutIntensity {
  RX
  SCALED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String

  photo  String? // path under /public, e.g. "/uploads/xyz.jpg"
  bio    String?
  age    Int?
  gender Gender?

  // Profile fields below are optional at signup time and filled in via the
  // profile edit form, so they're nullable even though every real profile
  // is expected to have them.
  area         String?
  affiliateGym String?
  level        Level?

  weightKg           Float?
  crossfitSinceYear  Int?
  crossfitSinceMonth Int?

  // JSON-encoded array of LookingFor values, e.g. ["TEAM_MATES"]
  lookingFor String?

  // Single status: isSingle is the underlying Yes/No answer; showSingleBadge
  // is a separate, defaulted-off opt-in to actually display the badge.
  isSingle        Boolean?
  showSingleBadge Boolean @default(false)

  // Governs whether new followers require approval once a follow system
  // exists; stored now so the setting has somewhere to live.
  isPrivate Boolean @default(false)

  // Key PBs (kg). Stored as individual nullable columns rather than a JSON
  // blob since SQLite has no native JSON column type.
  deadliftKg   Float?
  cleanKg      Float?
  frontSquatKg Float?
  backSquatKg  Float?
  ohsKg        Float?
  snatchKg     Float?
  benchPressKg Float?

  // Placeholders for future gym-platform integrations (Wodify/TeamUp/etc.);
  // not wired to anything yet.
  connectedPlatform String?
  platformUserId    String?

  createdAt DateTime @default(now())

  workouts Workout[]
}

model Workout {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  wodName   String
  score     String // free text: "12:34", "150 reps", "225 lb", "5 rounds + 10 reps", etc.
  unit      WorkoutUnit
  intensity WorkoutIntensity
  notes     String?
  photo     String? // path under /public, e.g. "/uploads/xyz.jpg"

  isPb Boolean @default(false)

  // Intent to share to the feed; the feed itself doesn't exist yet, so this
  // is stored for when it does rather than acted on now.
  sharedToFeed Boolean @default(false)

  // "manual" for now; a platform name (wodify/teamup/boxmate) once Tier 2
  // gym-platform integrations exist.
  source String @default("manual")

  createdAt DateTime @default(now())

  @@index([userId])
}
