generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Level {
  SCALED
  INTERMEDIATE
  RX
}

enum AccountType {
  ATHLETE
  AFFILIATE
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_DISCLOSE
}

enum AppTheme {
  PINK
  BLUE
}

// SQLite has no native array type, so `lookingFor` is stored as a
// JSON-encoded array of these values (see src/lib/lookingFor.ts).
enum LookingFor {
  TEAM_MATES
  FRIENDS
  DEEPER_CONNECTION
}

enum WorkoutUnit {
  TIME
  REPS
  WEIGHT
  ROUNDS_REPS
}

// A per-workout Rx/Scaled call, distinct from the athlete's overall Level
// (which also allows INTERMEDIATE) — a single WOD is only ever Rx'd or scaled.
enum WorkoutIntensity {
  RX
  SCALED
}

enum PostType {
  WORKOUT
  PR
  UPDATE
  TEAMMATE_REQUEST
}

enum FollowRequestStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

enum NotificationType {
  LIKE
  COMMENT
  REPLY
  COMMENT_LIKE
  MENTION
  EVENT_SUBMITTED
  GYM_SUBMITTED
  // A team's newly-posted "looking for teammates" request matched someone's
  // saved "find a team" search (EventTeammateAlert).
  TEAMMATE_REQUEST_MATCH
  // Someone's newly-saved "find a team" search matched an existing "looking
  // for teammates" request — the reverse direction of the above.
  TEAMMATE_SEARCH_MATCH
  // Someone reported a user or piece of content — sent to every admin.
  REPORT_SUBMITTED
  // A broadcast notice from Box 2 Box itself, sent to an admin-chosen
  // audience — see /admin/notices. The actor is the site account (see
  // src/lib/siteAccount.ts), and noticeId below has the actual content.
  SYSTEM_ANNOUNCEMENT
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
}

// SQLite has no native array type, so `division`, `teamFormat`, and
// `genderCategory` on Event are each stored as a JSON-encoded array of
// these values, same pattern as User.lookingFor.
enum EventDivision {
  SCALED
  RX
  INTERMEDIATE
}

enum EventTeamFormat {
  SINGLES
  PAIRS
  TEAMS
}

enum EventGenderCategory {
  MALE
  FEMALE
  MIXED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String

  photo  String? // served path, e.g. "/media/xyz.jpg" (see src/lib/uploads.ts)
  bio    String?
  age    Int?
  gender Gender?

  // Grants access to /events/review (approve/reject user-submitted events).
  // No broader role system — this is the only admin-gated capability so far.
  isAdmin Boolean @default(false)

  // AFFILIATE accounts represent a gym rather than an athlete — set once,
  // during profile setup (see EditProfileForm), and used throughout the app
  // to skip athlete-only fields/features (PBs, workout log, ability level,
  // relationship status, "looking for"). affiliateGym below doubles as
  // "which gym this account runs" for an AFFILIATE account.
  accountType AccountType @default(ATHLETE)

  // Set by an admin acting on a report (see /reports/review). A suspended
  // account can't sign in, and any existing session stops working on its
  // next request (see the session callback in src/lib/auth.ts). Null means
  // the account is in good standing.
  suspendedAt DateTime?

  // Set once the account owner deletes their account (see
  // /api/account/delete). The row is kept (rather than hard-deleted) and its
  // personal fields wiped, so messages/posts/reports that reference it keep
  // working and just show "Deleted User" — but sign-in is blocked exactly
  // like a suspension, since the email on the row no longer matches what
  // they signed up with anyway.
  deletedAt DateTime?

  // Consent captured at signup (see SignupForm) — timestamps double as an
  // audit trail of when each was agreed to, not just whether. Existing
  // accounts from before this shipped are grandfathered by
  // scripts/backfill-legal-consent.js.
  termsAcceptedAt DateTime?
  ageConfirmedAt  DateTime?

  // Email verification — informational (a banner prompts an unverified user
  // to confirm), never blocks sign-in. Null emailVerifiedAt means unverified.
  emailVerifiedAt                 DateTime?
  emailVerificationToken          String?   @unique
  emailVerificationTokenExpiresAt DateTime?

  // Forgot-password flow (see /forgot-password, /reset-password). Single-use:
  // cleared once the password is reset.
  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?

  // A short shareable code every account gets at signup (see
  // src/lib/inviteCode.ts) — shown in Settings so someone can invite others
  // and get credit for it. Existing accounts are backfilled by
  // scripts/backfill-invite-codes.js.
  inviteCode String? @unique

  // Set if this account signed up via someone else's invite code/link.
  // Null for organic signups. onDelete: SetNull so the referrer being
  // deleted doesn't take this signup's own account down with it.
  invitedById String?
  invitedBy   User?   @relation("Referrals", fields: [invitedById], references: [id], onDelete: SetNull)
  referrals   User[]  @relation("Referrals")

  // Free-text cohort label for pilot testing (e.g. "small" / "large") —
  // set by an admin (see /leaderboard), not chosen by the user. Null means
  // not assigned to either pilot group yet.
  testGroup String?

  // Each set once its onboarding popup has been shown (see
  // SectionOnboarding) — hasSeenOnboarding covers the welcome+profile-setup
  // popup shown right after signup; the rest are shown the first time the
  // user opens that section, never again after.
  hasSeenOnboarding    Boolean @default(false)
  hasSeenFeedTour      Boolean @default(false)
  hasSeenDiscoverTour  Boolean @default(false)
  hasSeenEventsTour    Boolean @default(false)
  hasSeenWorkoutsTour  Boolean @default(false)

  // Profile fields below are optional at signup time and filled in via the
  // profile edit form, so they're nullable even though every real profile
  // is expected to have them.
  area         String?
  // Geocoded from `area` (see src/lib/geocode.ts) so events can be filtered
  // by distance. Null until `area` is set/changed and geocoding succeeds.
  areaLat Float?
  areaLng Float?
  // A fixed list (see src/lib/countries.ts), not free text — kept separate
  // from `area` so admin notices (see /admin/notices) can filter by country
  // reliably rather than parsing it out of a free-text town/city.
  country String?
  // Either an approved Gym's name, "Unaffiliated", or "Other" — never other
  // free text, so search stays exact and reliable. For an AFFILIATE account
  // this is the gym they run rather than the gym they train at.
  affiliateGym String?
  // Only set when affiliateGym is "Other": what they actually typed, kept
  // for reference so it can be added to the official list later. Never
  // searched/filtered on.
  affiliateGymOther String?
  level             Level?

  // An AFFILIATE account can ask, from the bottom of the profile-setup form,
  // to be confirmed as the legitimate owner/manager of the gym named in
  // affiliateGym — reviewed manually by an admin (see /admin/verification).
  // Both null means never requested; verifiedAt null with a requested date
  // means pending review.
  verificationRequestedAt DateTime?
  verifiedAt              DateTime?

  crossfitSinceYear  Int?
  crossfitSinceMonth Int?

  // JSON-encoded array of LookingFor values, e.g. ["TEAM_MATES"]
  lookingFor String?

  // Age, relationship status, and looking-for tags are all collected, but
  // each is only ever displayed on the profile if the matching show* flag
  // (defaulted off) has been opted into via the edit-profile form.
  showAge Boolean @default(false)

  // Single status: isSingle is the underlying Yes/No answer. showRelationshipStatus
  // is a defaulted-off opt-in to display it as text; showSingleBadge is a
  // separate defaulted-off opt-in for the green-heart avatar badge, only
  // meaningful (and only ever true) when isSingle is true.
  isSingle               Boolean?
  showRelationshipStatus Boolean @default(false)
  showSingleBadge        Boolean @default(false)

  showLookingFor Boolean @default(false)

  // Governs whether new followers require approval once a follow system
  // exists; stored now so the setting has somewhere to live.
  isPrivate Boolean @default(false)

  // The app's color theme, set from Settings. Applied as a data-theme
  // attribute on <html> in the root layout (see src/app/globals.css).
  theme AppTheme @default(PINK)

  // Benchmark movement PBs (kg). Stored as individual nullable columns rather
  // than a JSON blob since SQLite has no native JSON column type. A user can
  // record any of these, but only up to 8 are shown on their profile — see
  // displayedPbs below.
  deadliftKg        Float?
  sumoDeadliftKg    Float?
  deficitDeadliftKg Float?
  cleanPullKg       Float?
  snatchPullKg      Float?
  cleanKg           Float?
  powerCleanKg      Float?
  hangCleanKg       Float?
  hangPowerCleanKg  Float?
  cleanAndJerkKg    Float?
  snatchKg          Float?
  powerSnatchKg     Float?
  hangSnatchKg      Float?
  hangPowerSnatchKg Float?
  splitJerkKg       Float?
  pushJerkKg        Float?
  strictPressKg     Float?
  shoulderPressKg   Float?
  pushPressKg       Float?
  benchPressKg      Float?
  frontSquatKg      Float?
  backSquatKg       Float?
  ohsKg             Float?

  // JSON-encoded array of up to 8 PbField keys (see src/lib/validation.ts)
  // chosen to display on the profile. Null means "not yet customized" — the
  // original fixed 8 are used as the default (see DEFAULT_DISPLAYED_PBS).
  displayedPbs String?

  // Placeholders for future gym-platform integrations (Wodify/TeamUp/etc.);
  // not wired to anything yet.
  connectedPlatform String?
  platformUserId    String?

  createdAt DateTime @default(now())

  workouts     Workout[]
  posts        Post[]
  likes        Like[]
  comments     Comment[]
  commentLikes CommentLike[]

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  sentFollowRequests     FollowRequest[] @relation("SentFollowRequests")
  receivedFollowRequests FollowRequest[] @relation("ReceivedFollowRequests")

  conversationsAsUserOne Conversation[] @relation("ConversationsAsUserOne")
  conversationsAsUserTwo Conversation[] @relation("ConversationsAsUserTwo")
  sentMessages           Message[]

  createdEvents        Event[]
  submittedEvents      Event[] @relation("EventSubmissions")
  submittedGyms        Gym[]   @relation("GymSubmissions")
  eventParticipations  EventParticipant[]
  eventInterests       EventInterest[]
  eventPins            EventPin[]
  eventNotices         EventNotice[]
  eventNoticeLikes     EventNoticeLike[]
  eventNoticeComments  EventNoticeComment[]
  eventTeammateAlerts  EventTeammateAlert[]

  blocksMade     Block[] @relation("BlocksMade")
  blocksReceived Block[] @relation("BlocksReceived")

  mutesMade     Mute[] @relation("MutesMade")
  mutesReceived Mute[] @relation("MutesReceived")

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")

  sentNotices Notice[] @relation("NoticesSent")

  reportsMade     Report[] @relation("ReportsMade")
  reportsReceived Report[] @relation("ReportsReceived")

  loginEvents LoginEvent[]
}

// One row per successful login — used only to measure "days active" on the
// pilot-testing leaderboard (see /leaderboard). Not used for anything
// security-related (see rateLimit.ts for that).
model LoginEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Workout {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  wodName   String
  score     String // free text, e.g. "12:34", "150 reps", "225 lb"; "5+10" (rounds+reps) when unit is ROUNDS_REPS
  unit      WorkoutUnit
  intensity WorkoutIntensity
  // The WOD's standard description (e.g. "21-15-9 reps of thrusters and
  // pull-ups"), auto-filled from the benchmark database when the name
  // matches — separate from notes, which is always manual free text.
  description String?
  notes       String?
  photo     String? // served path, e.g. "/media/xyz.jpg" (see src/lib/uploads.ts)
  video     String? // served path, e.g. "/media/xyz.mp4" — mutually exclusive with photo

  isPb Boolean @default(false)

  // Pinned to the top of "My Workouts", above the normal date ordering.
  pinned Boolean @default(false)

  // Intent to share to the feed; the feed itself doesn't exist yet, so this
  // is stored for when it does rather than acted on now.
  sharedToFeed Boolean @default(false)

  // "manual" for now; a platform name (wodify/teamup/boxmate) once Tier 2
  // gym-platform integrations exist.
  source String @default("manual")

  createdAt DateTime @default(now())

  @@index([userId])

  posts Post[]
}

model Post {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        PostType
  contentText String?
  photo       String? // served path, e.g. "/media/xyz.jpg" (see src/lib/uploads.ts)
  video       String? // served path, e.g. "/media/xyz.mp4" — mutually exclusive with photo

  // False for media added straight to the profile Gallery rather than posted
  // to the main feed. Every other kind of post (feed composer, workout
  // share, event join) sets this true, hence the default.
  sharedToFeed Boolean @default(true)

  // JSON-encoded array of teammate requests, set only when type is
  // TEAMMATE_REQUEST — a "find a teammate" search cross-posted from an
  // event's notices board (see EventNotice.teammateRequests). linkedEventId
  // below records which event it came from.
  teammateRequests String?

  // Set when auto-created from a workout logged with "share to feed" on.
  // Deleting that workout removes this post too, since it has nothing left to show.
  linkedWorkoutId String?
  linkedWorkout   Workout? @relation(fields: [linkedWorkoutId], references: [id], onDelete: Cascade)

  // Set when auto-created from joining an event's participant list. Deleting
  // the event removes this post too; un-joining removes it explicitly
  // (see the participate route) since the event itself still exists.
  linkedEventId String?
  linkedEvent   Event?  @relation(fields: [linkedEventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  likes         Like[]
  comments      Comment[]
  notifications Notification[]

  @@index([userId])
  @@index([createdAt])
}

model Like {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Set when this comment is a reply to another comment on the same post;
  // null for a top-level comment. One level of self-reference is enough —
  // the UI flattens deeper reply chains under their top-level ancestor.
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  text String

  createdAt DateTime @default(now())

  likes         CommentLike[]
  notifications Notification[]

  @@index([postId])
  @@index([parentId])
}

model CommentLike {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

model Follow {
  id String @id @default(cuid())

  followerId String
  follower   User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

// One row per (requester, target) pair — following a private profile again
// after a cancelled request reuses the same row rather than piling up history.
model FollowRequest {
  id String @id @default(cuid())

  requesterId String
  requester   User   @relation("SentFollowRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  targetId String
  target   User   @relation("ReceivedFollowRequests", fields: [targetId], references: [id], onDelete: Cascade)

  status FollowRequestStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([requesterId, targetId])
  @@index([targetId])
}

// One row per pair of participants. userOneId/userTwoId are always stored in
// a canonical order (lexicographically smaller id first — see
// src/lib/conversations.ts) so the unique constraint catches a duplicate
// conversation regardless of who started it.
model Conversation {
  id String @id @default(cuid())

  userOneId String
  userOne   User   @relation("ConversationsAsUserOne", fields: [userOneId], references: [id], onDelete: Cascade)

  userTwoId String
  userTwo   User   @relation("ConversationsAsUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  messages Message[]

  @@unique([userOneId, userTwoId])
  @@index([userTwoId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  text String

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([conversationId])
}

model Event {
  id String @id @default(cuid())

  name String
  date DateTime // the event's start date/time

  // Set only for an event that runs across more than one day — null means
  // a single-day event (display code should treat null as "same as date").
  endDate DateTime?

  // True for an event with no physical venue — location is null in that
  // case, and never geocoded/distance-filtered.
  isOnline Boolean @default(false)
  location String? // required unless isOnline (see eventSubmissionSchema)

  description String? // free text "event information" — required for a user submission, optional for a curated listing
  tag         String? // free text, e.g. "Team size: 3", "Charity", "RX division"
  photo       String? // served path, e.g. "/media/xyz.jpg" (see src/lib/uploads.ts) — the event's image
  websiteUrl  String? // link to the event's own site

  // JSON-encoded arrays of EventDivision/EventTeamFormat/EventGenderCategory
  // values (see the enum comment above) — each required (min 1) for a user
  // submission, via the eventSubmissionSchema in src/lib/validation.ts.
  division       String?
  teamFormat     String?
  genderCategory String?

  // Geocoded from `location` (see src/lib/geocode.ts), lazily on first read,
  // so Discover can filter by distance from the athlete's own area.
  lat Float?
  lng Float?

  // Curated listings (added directly, e.g. via Prisma Studio or the
  // backfill scripts) are created APPROVED and createdById is just
  // bookkeeping for whichever account performed that action, not a real
  // author. A user submission (source "user_submission") is created
  // PENDING with createdById/submittedById both set to the real submitter,
  // and only shows up in Discover once a moderator approves it.
  status EventStatus @default(APPROVED)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  submittedById String?
  submittedBy   User?   @relation("EventSubmissions", fields: [submittedById], references: [id], onDelete: SetNull)

  // "manual" for a curated listing, "user_submission" for one submitted
  // in-app; an aggregator name (compete-zone/etc.) once Tier 2 partnered
  // event feeds exist.
  source String @default("manual")

  createdAt DateTime @default(now())

  participants  EventParticipant[]
  interests     EventInterest[]
  pins          EventPin[]
  notices        EventNotice[]
  posts          Post[]
  notifications  Notification[]
  teammateAlerts EventTeammateAlert[]

  @@index([date])
}

model EventParticipant {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([eventId])
}

// "I'm interested" (looking for a team) is tracked separately from actually
// participating — marking interest auto-posts a notice on the event's board
// (see EventNotice) and un-marking it removes that same notice, without
// touching any notices the athlete wrote by hand.
model EventInterest {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  noticeId String?      @unique
  notice   EventNotice? @relation(fields: [noticeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([eventId])
}

// Pins an event to the top of "My Events" — independent of participating or
// interested status, so pinning survives switching between the two.
model EventPin {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([eventId])
}

// A lightweight classified-ads board scoped to one event — separate from the
// main feed so "looking for teammates for FORTIOR 4" posts don't clutter
// everyone's feed and stay easy to find by anyone eyeing that event.
model EventNotice {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Required for a plain free-text notice; optional extra detail alongside
  // teammateRequests.
  text String?

  // JSON-encoded array of teammate requests posted together for this event,
  // e.g. [{"quantity":1,"gender":"MALE","division":"RX"},{"quantity":1,"gender":"FEMALE","division":"RX"}]
  // — multiple athletes needed for the same event stay one feed post rather
  // than being split across several. Null for a plain free-text notice.
  teammateRequests String?

  createdAt DateTime @default(now())

  // Set when this notice is the auto-generated one behind an "I'm
  // interested" mark (see EventInterest.noticeId) — null for a notice
  // someone wrote by hand.
  interest EventInterest?

  likes    EventNoticeLike[]
  comments EventNoticeComment[]

  @@index([eventId])
}

// A saved "find a team" search — lets someone with no current matches get
// notified the moment a team posts a request that fits (TEAMMATE_REQUEST_MATCH),
// and immediately notifies the reverse direction too: any team whose existing
// request already matches this alert (TEAMMATE_SEARCH_MATCH), so both sides
// of a fit hear about each other without waiting for the other to search.
model EventTeammateAlert {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // TeammateGenderOption/TeammateDivisionOption from src/lib/validation.ts,
  // including "ANY" — same matching semantics as EventNotice.teammateRequests.
  gender   String
  division String

  createdAt DateTime @default(now())

  @@unique([eventId, userId, gender, division])
  @@index([eventId])
}

model EventNoticeLike {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  noticeId String
  notice   EventNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, noticeId])
  @@index([noticeId])
}

model EventNoticeComment {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  noticeId String
  notice   EventNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  // One level of self-reference, same as Comment — a reply to a reply is
  // flattened under its top-level ancestor in the UI.
  parentId String?
  parent   EventNoticeComment?  @relation("EventNoticeCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  EventNoticeComment[] @relation("EventNoticeCommentReplies")

  text String

  createdAt DateTime @default(now())

  @@index([noticeId])
  @@index([parentId])
}

model Block {
  id String @id @default(cuid())

  blockerId String
  blocker   User   @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String
  blocked   User   @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Mute {
  id String @id @default(cuid())

  userId String
  user   User   @relation("MutesMade", fields: [userId], references: [id], onDelete: Cascade)

  mutedUserId String
  mutedUser   User   @relation("MutesReceived", fields: [mutedUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, mutedUserId])
  @@index([mutedUserId])
}

model Notification {
  id String @id @default(cuid())

  // Who sees this notification.
  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  // Who did the thing that triggered it.
  actorId String
  actor   User   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  type NotificationType

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Set for REPLY/COMMENT_LIKE, and for MENTION when the mention was inside
  // a comment rather than the post body itself.
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // Set for EVENT_SUBMITTED — the event awaiting review.
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Set for GYM_SUBMITTED — the gym awaiting review.
  gymId String?
  gym   Gym?    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  // Set for SYSTEM_ANNOUNCEMENT — the notice being broadcast (title/body live
  // there, shared across every recipient's Notification row).
  noticeId String?
  notice   Notice? @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([noticeId])
}

// A broadcast message from Box 2 Box itself, sent to an admin-chosen
// audience (see /admin/notices and /api/admin/notices). Each recipient gets
// their own Notification row (type SYSTEM_ANNOUNCEMENT, noticeId pointing
// here) — this row is the shared content, not a per-recipient copy.
model Notice {
  id String @id @default(cuid())

  title String
  body  String

  sentById String
  sentBy   User   @relation("NoticesSent", fields: [sentById], references: [id], onDelete: Cascade)

  // Audience filters applied at send time — all optional, null meaning "no
  // restriction on this dimension". Kept only as a record of who this went
  // to; recipients are the Notification rows below, never re-derived from
  // these later (so the audience shown here can't drift from who actually
  // got it, even if e.g. a user's gym changes afterwards).
  audienceGender       Gender?
  audienceMinAge       Int?
  audienceMaxAge       Int?
  audienceLevel        Level?
  audienceAffiliateGym String?
  audienceCountry      String?
  audienceAreaQuery    String?
  audienceRadiusMiles  Int?

  recipientCount Int @default(0)

  createdAt DateTime @default(now())

  notifications Notification[]

  @@index([sentById])
}

enum ReportTargetType {
  USER
  POST
  COMMENT
  MESSAGE
  EVENT_NOTICE
  EVENT_NOTICE_COMMENT
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  NUDITY
  VIOLENCE
  SELF_HARM
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  OPEN
  // Reviewed, no action needed.
  DISMISSED
  // Content removed and/or its author suspended.
  ACTIONED
}

// A user flagging another user, or something they posted, for an admin to
// review at /reports/review. targetId points at a row of the table named by
// targetType — deliberately not a foreign key, so the report (and its
// snapshot) survives the content being deleted. contentSnapshot records what
// the content said at report time, so an edit afterwards can't hide it from
// the reviewer.
model Report {
  id String @id @default(cuid())

  reporterId String
  reporter   User   @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  // Whoever owns the reported content (or the reported user themselves).
  reportedUserId String
  reportedUser   User   @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)

  targetType ReportTargetType
  targetId   String

  reason  ReportReason
  details String?

  contentSnapshot String?
  // Served path of an attached photo/video at report time, if any.
  mediaSnapshot String?

  status     ReportStatus @default(OPEN)
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  // Reporting the same thing twice updates the existing report rather than
  // piling up duplicates in the review queue.
  @@unique([reporterId, targetType, targetId])
  @@index([status])
  @@index([targetType, targetId])
}

enum GymStatus {
  PENDING
  APPROVED
  REJECTED
}

// A details page for an affiliate gym shown in Discover's Affiliates tab.
// The fixed gyms in src/lib/gyms.ts (AFFILIATE_GYMS) are curated — added
// directly (e.g. via Prisma Studio), created APPROVED, "name" matching
// User.affiliateGym's string exactly. Anyone can also submit a gym that
// isn't in that fixed list via /gyms/submit, same review flow as Event: PENDING
// until a moderator approves it, and never selectable as a profile's
// affiliateGym (that dropdown stays the fixed list) — this is purely a
// browsable directory entry.
model Gym {
  id String @id @default(cuid())

  name        String  @unique
  description String?
  address     String?
  website     String?
  photo       String? // served path, e.g. "/media/xyz.jpg" (see src/lib/uploads.ts)

  // Geocoded from `address` (see src/lib/geocode.ts), lazily on first read,
  // so Discover's Affiliates tab can filter by distance from the athlete's
  // own area.
  lat Float?
  lng Float?

  status GymStatus @default(APPROVED)

  submittedById String?
  submittedBy   User?   @relation("GymSubmissions", fields: [submittedById], references: [id], onDelete: SetNull)

  // "manual" for a curated listing, "user_submission" for one submitted in-app.
  source String @default("manual")

  createdAt DateTime @default(now())

  notifications Notification[]
}
