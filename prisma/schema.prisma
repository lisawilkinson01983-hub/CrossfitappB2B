generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Level {
  SCALED
  INTERMEDIATE
  RX
}

enum AccountType {
  ATHLETE
  AFFILIATE
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_DISCLOSE
}

// SQLite has no native array type, so `lookingFor` is stored as a
// JSON-encoded array of these values (see src/lib/lookingFor.ts).
enum LookingFor {
  TEAM_MATES
  FRIENDS
  DEEPER_CONNECTION
}

// A short self-reported "how I'm doing" status shown in the feed's status
// bar (see StatusReaction, User.status) — persists until the person changes
// or clears it, not a 24h story.
enum UserStatus {
  INJURED
  FIGHTING_FIT
  ADAPTING
}

enum WorkoutUnit {
  TIME
  REPS
  WEIGHT
  ROUNDS_REPS
}

// A per-workout Rx/Scaled call, distinct from the athlete's overall Level
// (which also allows INTERMEDIATE) — a single WOD is only ever Rx'd or scaled.
enum WorkoutIntensity {
  RX
  SCALED
}

enum PostType {
  WORKOUT
  PR
  UPDATE
  TEAMMATE_REQUEST
}

enum PostMediaKind {
  PHOTO
  VIDEO
}

enum FollowRequestStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

enum NotificationType {
  LIKE
  COMMENT
  REPLY
  COMMENT_LIKE
  MENTION
  EVENT_SUBMITTED
  GYM_SUBMITTED
  // A team's newly-posted "looking for teammates" request matched someone's
  // saved "find a team" search (EventTeammateAlert).
  TEAMMATE_REQUEST_MATCH
  // Someone's newly-saved "find a team" search matched an existing "looking
  // for teammates" request — the reverse direction of the above.
  TEAMMATE_SEARCH_MATCH
  // Someone reported a user or piece of content — sent to every admin.
  REPORT_SUBMITTED
  // An AFFILIATE account requested verification as the owner/manager of its
  // gym (see User.verificationRequestedAt) — sent to every admin, same as
  // GYM_SUBMITTED/EVENT_SUBMITTED/REPORT_SUBMITTED above.
  AFFILIATE_VERIFICATION_REQUESTED
  // A broadcast notice from Box 2 Box itself, sent to an admin-chosen
  // audience — see /admin/notices. The actor is the site account (see
  // src/lib/siteAccount.ts), and noticeId below has the actual content.
  SYSTEM_ANNOUNCEMENT
  // Invited to a private event (see EventInvite) — eventId below has the event.
  EVENT_INVITE
  // Someone started following this user (immediately, for a public profile —
  // a private profile's pending request is a separate flow, not notified here).
  FOLLOW
  // Someone shared this user's post to their own feed (see Post.sharedFromId).
  POST_SHARE
  // Someone reacted to this user's current status (see StatusReaction).
  STATUS_REACTION
  // Someone marked themselves as participating in this user's private event
  // — eventId below has the event. Sent to the organizer only (see
  // /api/events/[id]/participate); public events don't send this, since
  // there's no single organizer watching every join the way there is for a
  // small private one.
  EVENT_PARTICIPANT_JOINED
  // Someone reacted to this user's comment with an emoji (see
  // CommentReaction) — separate from the simpler COMMENT_LIKE heart.
  COMMENT_REACTION
  // Someone commented on this user's logged workout (see WorkoutComment) —
  // reached from a gallery photo/video sourced from a workout.
  WORKOUT_COMMENT
  // Someone commented on one of this user's PBs (see PbComment).
  PB_COMMENT
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
}

// SQLite has no native array type, so `division`, `teamFormat`, and
// `genderCategory` on Event are each stored as a JSON-encoded array of
// these values, same pattern as User.lookingFor.
// NA opts out of this field entirely — e.g. a social event with no ability
// requirement — and is mutually exclusive with the real values (see the
// `toggle` helper in EventSubmitForm).
enum EventDivision {
  SCALED
  RX
  INTERMEDIATE
  NA
}

enum EventTeamFormat {
  SINGLES
  PAIRS
  TEAMS
  NA
}

enum EventGenderCategory {
  MALE
  FEMALE
  MIXED
  NA
}

// A free-choice classification for what kind of event this is — OTHER pairs
// with Event.eventKindOther for free text, same pattern as
// User.affiliateGym/affiliateGymOther.
enum EventKind {
  COMPETITION
  SOCIAL
  OTHER
}

// The real person's login — separate from any one profile, so one email and
// password can hold more than one profile (e.g. an athlete profile and the
// affiliate profile for the gym they run), switching between them without
// signing out (see /api/account/switch-profile). Every User row (profile)
// belongs to exactly one Account; an Account can have more than one User.
model Account {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  // Set by an admin acting on a report — blocks sign-in for every profile
  // under this account, not just the one that was reported (see the session
  // callback in src/lib/auth.ts).
  suspendedAt DateTime?
  // Set once every profile under this account has gone through
  // /api/account/delete. Blocks sign-in exactly like a suspension.
  deletedAt   DateTime?

  // Email verification — informational, never blocks sign-in. Null
  // emailVerifiedAt means unverified.
  emailVerifiedAt                 DateTime?
  emailVerificationToken          String?   @unique
  emailVerificationTokenExpiresAt DateTime?

  // Forgot-password flow (see /forgot-password, /reset-password).
  // Single-use: cleared once the password is reset.
  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?

  createdAt DateTime @default(now())

  profiles            User[]
  // Profiles owned by a *different* Account that this one has been granted a
  // toggle onto (see ProfileAccess) — e.g. letting more than one admin login
  // switch to the shared Box 2 Box brand profile without sharing its
  // password. Separate from `profiles` above, which is actual ownership.
  sharedProfileAccess ProfileAccess[]
}

/// Grants one Account a toggle (via /settings/profiles) onto a User profile
/// it doesn't own — e.g. several admins sharing the Box 2 Box brand profile.
/// The profile stays owned by its original Account; this only adds another
/// login that can switch onto it. See /api/account/switch-profile.
model ProfileAccess {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  profileId String
  profile   User     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([accountId, profileId])
}

model User {
  id   String @id @default(cuid())
  name String

  // The login this profile belongs to — see Account above. Nullable only
  // until scripts/backfill-accounts.js has run once against rows that
  // predate the Account split; every profile has one from then on.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  photo       String? // served path, e.g. "/media/xyz.jpg" (see src/lib/uploads.ts)
  // The wide cover band behind the avatar on the profile card — optional,
  // falls back to a plain brand-colored band when unset. Uploaded and
  // cropped the same way as `photo` (see ImageCropper), just a wide aspect
  // instead of square.
  bannerPhoto String?
  bio         String?
  // Stored as a date of birth (not a static age) so a displayed age stays
  // correct after a birthday without anyone having to go edit it — see
  // src/lib/age.ts for deriving the actual age from this.
  dateOfBirth DateTime?
  gender      Gender?

  // Grants access to /events/review (approve/reject user-submitted events).
  // No broader role system — this is the only admin-gated capability so far.
  isAdmin Boolean @default(false)

  // AFFILIATE accounts represent a gym rather than an athlete — set once,
  // during profile setup (see EditProfileForm), and used throughout the app
  // to skip athlete-only fields/features (PBs, workout log, ability level,
  // relationship status, "looking for"). affiliateGym below doubles as
  // "which gym this account runs" for an AFFILIATE account.
  accountType AccountType @default(ATHLETE)

  // Consent captured at signup (see SignupForm) — timestamps double as an
  // audit trail of when each was agreed to, not just whether. Existing
  // accounts from before this shipped are grandfathered by
  // scripts/backfill-legal-consent.js. Re-stamped (not re-asked) when a
  // second profile is added to an already-consented Account.
  termsAcceptedAt DateTime?
  ageConfirmedAt  DateTime?

  // --- Superseded by Account (see above) — login/identity now lives there,
  // shared across every profile under one Account. These stay only so
  // scripts/backfill-accounts.js has something to migrate from on a row that
  // predates the Account split; nothing else reads or writes them.
  email                           String?   @unique
  passwordHash                    String?
  suspendedAt                     DateTime?
  deletedAt                       DateTime?
  emailVerifiedAt                 DateTime?
  emailVerificationToken          String?   @unique
  emailVerificationTokenExpiresAt DateTime?
  passwordResetToken              String?   @unique
  passwordResetTokenExpiresAt     DateTime?
  // --- end superseded ---

  // A short shareable code every account gets at signup (see
  // src/lib/inviteCode.ts) — shown in Settings so someone can invite others
  // and get credit for it. Existing accounts are backfilled by
  // scripts/backfill-invite-codes.js.
  inviteCode String? @unique

  // Set if this account signed up via someone else's invite code/link.
  // Null for organic signups. onDelete: SetNull so the referrer being
  // deleted doesn't take this signup's own account down with it.
  invitedById String?
  invitedBy   User?   @relation("Referrals", fields: [invitedById], references: [id], onDelete: SetNull)
  referrals   User[]  @relation("Referrals")

  // Free-text cohort label for pilot testing (e.g. "small" / "large") —
  // set by an admin (see /leaderboard), not chosen by the user. Null means
  // not assigned to either pilot group yet.
  testGroup String?

  // Each set once its onboarding popup has been shown (see
  // SectionOnboarding) — hasSeenOnboarding covers the welcome+profile-setup
  // popup shown right after signup; the rest are shown the first time the
  // user opens that section, never again after.
  hasSeenOnboarding   Boolean @default(false)
  hasSeenFeedTour     Boolean @default(false)
  hasSeenDiscoverTour Boolean @default(false)
  hasSeenEventsTour   Boolean @default(false)
  hasSeenWorkoutsTour Boolean @default(false)

  // Profile fields below are optional at signup time and filled in via the
  // profile edit form, so they're nullable even though every real profile
  // is expected to have them.
  area              String?
  // Geocoded from `area` (see src/lib/geocode.ts) so events can be filtered
  // by distance. Null until `area` is set/changed and geocoding succeeds.
  areaLat           Float?
  areaLng           Float?
  // A fixed list (see src/lib/countries.ts), not free text — kept separate
  // from `area` so admin notices (see /admin/notices) can filter by country
  // reliably rather than parsing it out of a free-text town/city.
  country           String?
  // Either an approved Gym's name, "Unaffiliated", or "Other" — never other
  // free text, so search stays exact and reliable. For an AFFILIATE account
  // this is the gym they run rather than the gym they train at.
  affiliateGym      String?
  // Only set when affiliateGym is "Other": what they actually typed, kept
  // for reference so it can be added to the official list later. Never
  // searched/filtered on.
  affiliateGymOther String?
  // Only asked of an AFFILIATE account (see EditProfileForm) — shown as a
  // button on their own profile page (see ProfileDetails), separate from the
  // admin-curated Gym.website on the static directory entry.
  website           String?
  // Deprecated — superseded by `levels` below (an athlete can now hold up to
  // 2 ability levels, e.g. Scaled and Intermediate, to find teams across
  // both). Kept rather than dropped so scripts/backfill-levels.js has
  // something to migrate from; never read or written to elsewhere.
  level             Level?
  // JSON-encoded array of Level values (see src/lib/validation.ts's LEVELS),
  // max 2 — same JSON-string-array pattern as lookingFor below.
  levels            String?

  // An AFFILIATE account can ask, from the bottom of the profile-setup form,
  // to be confirmed as the legitimate owner/manager of the gym named in
  // affiliateGym — reviewed manually by an admin (see /admin/verification).
  // Both null means never requested; verifiedAt null with a requested date
  // means pending review.
  verificationRequestedAt DateTime?
  verifiedAt              DateTime?

  crossfitSinceYear  Int?
  crossfitSinceMonth Int?

  // JSON-encoded array of LookingFor values, e.g. ["TEAM_MATES"]
  lookingFor String?

  // Age, relationship status, and looking-for tags are all collected, but
  // each is only ever displayed on the profile if the matching show* flag
  // (defaulted off) has been opted into via the edit-profile form.
  showAge Boolean @default(false)

  // Single status: isSingle is the underlying Yes/No answer. showRelationshipStatus
  // is a defaulted-off opt-in to display it as text; showSingleBadge is a
  // separate defaulted-off opt-in for the green-heart avatar badge, only
  // meaningful (and only ever true) when isSingle is true.
  isSingle               Boolean?
  showRelationshipStatus Boolean  @default(false)
  showSingleBadge        Boolean  @default(false)

  showLookingFor Boolean @default(false)

  // Governs whether new followers require approval once a follow system
  // exists; stored now so the setting has somewhere to live.
  isPrivate Boolean @default(false)

  // Current "how I'm doing" status shown at the top of the feed — null means
  // no status set. statusUpdatedAt orders the feed's status bar by recency
  // and doubles as "when the current status started", so reactions reset
  // (see /api/status) whenever it changes.
  status          UserStatus?
  statusUpdatedAt DateTime?

  // Opt-out for other people sharing this user's posts to their own feed
  // (see Post.sharedFromId / /api/posts/[id]/share) — defaulted on.
  allowPostShares Boolean @default(true)

  // Benchmark movement PBs (kg). Stored as individual nullable columns rather
  // than a JSON blob since SQLite has no native JSON column type. A user can
  // record any of these, but only up to 8 are shown on their profile — see
  // displayedPbs below.
  deadliftKg        Float?
  sumoDeadliftKg    Float?
  deficitDeadliftKg Float?
  cleanPullKg       Float?
  snatchPullKg      Float?
  cleanKg           Float?
  powerCleanKg      Float?
  hangCleanKg       Float?
  hangPowerCleanKg  Float?
  cleanAndJerkKg    Float?
  snatchKg          Float?
  powerSnatchKg     Float?
  hangSnatchKg      Float?
  hangPowerSnatchKg Float?
  splitJerkKg       Float?
  pushJerkKg        Float?
  strictPressKg     Float?
  shoulderPressKg   Float?
  pushPressKg       Float?
  benchPressKg      Float?
  frontSquatKg      Float?
  backSquatKg       Float?
  ohsKg             Float?

  // JSON-encoded array of up to 8 PbField keys (see src/lib/validation.ts)
  // chosen to display on the profile. Null means "not yet customized" — the
  // original fixed 8 are used as the default (see DEFAULT_DISPLAYED_PBS).
  displayedPbs String?

  // Placeholders for future gym-platform integrations (Wodify/TeamUp/etc.);
  // not wired to anything yet.
  connectedPlatform String?
  platformUserId    String?

  createdAt DateTime @default(now())

  workouts         Workout[]
  posts            Post[]
  likes            Like[]
  savedPosts       SavedPost[]
  comments         Comment[]
  commentLikes     CommentLike[]
  commentReactions CommentReaction[]
  messageReactions MessageReaction[]
  stories          Story[]
  storyViews       StoryView[]

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  sentFollowRequests     FollowRequest[] @relation("SentFollowRequests")
  receivedFollowRequests FollowRequest[] @relation("ReceivedFollowRequests")

  conversationsAsUserOne   Conversation[]            @relation("ConversationsAsUserOne")
  conversationsAsUserTwo   Conversation[]            @relation("ConversationsAsUserTwo")
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]

  createdEvents        Event[]
  submittedEvents      Event[]              @relation("EventSubmissions")
  submittedGyms        Gym[]                @relation("GymSubmissions")
  claimedGym           Gym?                 @relation("GymClaim")
  // Other Accounts granted a toggle onto this profile — see ProfileAccess.
  sharedWithAccounts   ProfileAccess[]
  eventParticipations  EventParticipant[]
  eventInterests       EventInterest[]
  eventPins            EventPin[]
  eventNotices         EventNotice[]
  eventNoticeLikes     EventNoticeLike[]
  eventNoticeComments  EventNoticeComment[]
  eventTeammateAlerts  EventTeammateAlert[]
  eventInvitesReceived EventInvite[]        @relation("EventInvitesReceived")
  eventInvitesSent     EventInvite[]        @relation("EventInvitesSent")
  eventWorkoutPhotos   EventWorkoutPhoto[]

  blocksMade     Block[] @relation("BlocksMade")
  blocksReceived Block[] @relation("BlocksReceived")

  mutesMade     Mute[] @relation("MutesMade")
  mutesReceived Mute[] @relation("MutesReceived")

  statusReactionsReceived StatusReaction[] @relation("StatusReactionsReceived")
  statusReactionsGiven    StatusReaction[] @relation("StatusReactionsGiven")

  workoutComments    WorkoutComment[]
  pbCommentsReceived PbComment[]      @relation("PbCommentsReceived")
  pbCommentsWritten  PbComment[]      @relation("PbCommentsWritten")

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")

  sentNotices Notice[] @relation("NoticesSent")

  reportsMade     Report[] @relation("ReportsMade")
  reportsReceived Report[] @relation("ReportsReceived")

  loginEvents LoginEvent[]
}

// One row per successful login — used only to measure "days active" on the
// pilot-testing leaderboard (see /leaderboard). Not used for anything
// security-related (see rateLimit.ts for that).
model LoginEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Workout {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  wodName        String
  score          String // free text, e.g. "12:34", "150 reps", "225 lb"; "5+10" (rounds+reps) when unit is ROUNDS_REPS
  unit           WorkoutUnit
  intensity      WorkoutIntensity
  // The WOD's standard description (e.g. "21-15-9 reps of thrusters and
  // pull-ups"), auto-filled from the benchmark database when the name
  // matches — separate from notes, which is always manual free text.
  description    String?
  notes          String?
  photo          String? // served path, e.g. "/media/xyz.jpg" (see src/lib/uploads.ts)
  video          String? // served path, e.g. "/media/xyz.mp4" — mutually exclusive with photo
  // A frame captured client-side from `video` at attach time (see
  // src/lib/readVideoInfo.ts) and used as its poster — without one, <video>
  // just shows a black box until played.
  videoThumbnail String?

  isPb Boolean @default(false)

  // Pinned to the top of "My Workouts", above the normal date ordering.
  pinned Boolean @default(false)

  // Intent to share to the feed; the feed itself doesn't exist yet, so this
  // is stored for when it does rather than acted on now.
  sharedToFeed Boolean @default(false)

  // "manual" for now; a platform name (wodify/teamup/boxmate) once Tier 2
  // gym-platform integrations exist.
  source String @default("manual")

  createdAt DateTime @default(now())

  posts         Post[]
  comments      WorkoutComment[]
  notifications Notification[]

  @@index([userId])
}

model Post {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type           PostType
  contentText    String?
  // Single-media legacy fields — posts created before multi-media support
  // (PostMedia below) still read from these; every new post uses `media`
  // instead, even for just one photo or video.
  photo          String? // served path, e.g. "/media/xyz.jpg" (see src/lib/uploads.ts)
  video          String? // served path, e.g. "/media/xyz.mp4" — mutually exclusive with photo
  // A frame captured client-side from `video` at attach time (see
  // src/lib/readVideoInfo.ts) and used as its poster — without one, <video>
  // just shows a black box until played.
  videoThumbnail String?

  // A post's photos/videos, in carousel order — see PostMedia below.
  media PostMedia[]

  // False for media added straight to the profile Gallery rather than posted
  // to the main feed. Every other kind of post (feed composer, workout
  // share, event join) sets this true, hence the default.
  sharedToFeed Boolean @default(true)

  // JSON-encoded array of teammate requests, set only when type is
  // TEAMMATE_REQUEST — a "find a teammate" search cross-posted from an
  // event's notices board (see EventNotice.teammateRequests). linkedEventId
  // below records which event it came from.
  teammateRequests String?

  // Set when auto-created from a workout logged with "share to feed" on.
  // Deleting that workout removes this post too, since it has nothing left to show.
  linkedWorkoutId String?
  linkedWorkout   Workout? @relation(fields: [linkedWorkoutId], references: [id], onDelete: Cascade)

  // Set when auto-created from joining an event's participant list. Deleting
  // the event removes this post too; un-joining removes it explicitly
  // (see the participate route) since the event itself still exists.
  linkedEventId String?
  linkedEvent   Event?  @relation(fields: [linkedEventId], references: [id], onDelete: Cascade)

  // Set when this post is a share/reshare of another post to the sharer's
  // own feed (see /api/posts/[id]/share) — a share row carries none of its
  // own content (contentText/media/etc. stay null); PostCard reads the
  // original's content through this relation instead. Always points at a
  // true original, never at another share, so resharing a share re-points
  // here at that share's own sharedFromId rather than chaining.
  sharedFromId String?
  sharedFrom   Post?   @relation("PostShares", fields: [sharedFromId], references: [id], onDelete: Cascade)
  shares       Post[]  @relation("PostShares")

  createdAt DateTime @default(now())

  likes         Like[]
  savedBy       SavedPost[]
  comments      Comment[]
  notifications Notification[]

  @@unique([userId, sharedFromId])
  @@index([userId])
  @@index([createdAt])
}

// A private bookmark — unlike Like, never notifies the post's author and
// never shows up anywhere but the saver's own "Saved" list (see
// /profile/saved). Same shape as Like/CommentLike/EventNoticeLike.
model SavedPost {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

// One photo or video in a post's carousel (see Post.media). `order` controls
// display/swipe order; `thumbnail` is only ever set for a VIDEO (a poster
// frame captured client-side, same as Post.videoThumbnail).
model PostMedia {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  kind      PostMediaKind
  url       String
  thumbnail String?
  order     Int

  @@index([postId])
}

model Like {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Set when this comment is a reply to another comment on the same post;
  // null for a top-level comment. One level of self-reference is enough —
  // the UI flattens deeper reply chains under their top-level ancestor.
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  text String

  // A GIF attached to the comment (its direct media URL from the GIF
  // provider — see src/lib/tenor.ts) — not re-hosted, just linked. A comment
  // can be GIF-only (see commentSchema's refine in src/lib/validation.ts).
  gifUrl String?

  createdAt DateTime @default(now())

  likes         CommentLike[]
  reactions     CommentReaction[]
  notifications Notification[]

  @@index([postId])
  @@index([parentId])
}

model CommentLike {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

// A emoji reaction (see REACTION_EMOJIS in src/lib/validation.ts) on a
// comment — distinct from the simpler single-heart CommentLike above. One
// user can leave more than one different emoji on the same comment, but
// never the same emoji twice (toggled off instead — see
// /api/comments/[id]/react).
model CommentReaction {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  emoji     String

  createdAt DateTime @default(now())

  @@unique([userId, commentId, emoji])
  @@index([commentId])
}

// Someone reacting to another user's current status (see User.status) —
// scoped to whatever status is active right now: /api/status clears every
// row here for a user the moment they change or clear their own status, so
// a reaction always reflects the status it was given on.
model StatusReaction {
  id String @id @default(cuid())

  // Whose status this reaction is on.
  userId String
  user   User   @relation("StatusReactionsReceived", fields: [userId], references: [id], onDelete: Cascade)

  // Who reacted.
  reactorId String
  reactor   User   @relation("StatusReactionsGiven", fields: [reactorId], references: [id], onDelete: Cascade)

  // Which of the fixed REACTION_EMOJIS this is — same shape as
  // CommentReaction/MessageReaction. One reactor can leave several different
  // emoji on the same status, toggled individually.
  emoji String @default("👍")

  createdAt DateTime @default(now())

  @@unique([userId, reactorId, emoji])
  @@index([userId])
}

// A comment on a logged workout — reached from a gallery photo/video sourced
// from a workout (see src/lib/gallery.ts's "workout" MediaSource). Shown in a
// popout rather than inline, but otherwise the same reply/edit/delete/report
// feature set as Comment/EventNoticeComment — just no GIFs/reactions.
model WorkoutComment {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  // One level of self-reference, same as Comment — a reply to a reply is
  // flattened under its top-level ancestor in the UI.
  parentId String?
  parent   WorkoutComment?  @relation("WorkoutCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  WorkoutComment[] @relation("WorkoutCommentReplies")

  text String

  createdAt DateTime @default(now())

  @@index([workoutId])
  @@index([parentId])
}

// A comment on one specific PB value on someone's profile (see
// src/lib/validation.ts's PB_FIELDS) — shown in a popout when that PB tile is
// tapped. Same reply/edit/delete/report feature set as WorkoutComment.
model PbComment {
  id String @id @default(cuid())

  // Whose PB this is about.
  profileUserId String
  profileUser   User   @relation("PbCommentsReceived", fields: [profileUserId], references: [id], onDelete: Cascade)

  // Which PB_FIELDS entry, e.g. "backSquatKg".
  field String

  // Who wrote it.
  userId String
  user   User   @relation("PbCommentsWritten", fields: [userId], references: [id], onDelete: Cascade)

  // One level of self-reference, same as Comment — a reply to a reply is
  // flattened under its top-level ancestor in the UI.
  parentId String?
  parent   PbComment?  @relation("PbCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  PbComment[] @relation("PbCommentReplies")

  text String

  createdAt DateTime @default(now())

  @@index([profileUserId, field])
  @@index([parentId])
}

model Follow {
  id String @id @default(cuid())

  followerId String
  follower   User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

// One row per (requester, target) pair — following a private profile again
// after a cancelled request reuses the same row rather than piling up history.
model FollowRequest {
  id String @id @default(cuid())

  requesterId String
  requester   User   @relation("SentFollowRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  targetId String
  target   User   @relation("ReceivedFollowRequests", fields: [targetId], references: [id], onDelete: Cascade)

  status FollowRequestStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([requesterId, targetId])
  @@index([targetId])
}

// A conversation between any number of participants (see
// ConversationParticipant) — a 1:1 chat is just a two-participant
// conversation with isGroup false. name is only ever set for a group;
// a null name falls back to the other participants' names joined together
// (see conversationDisplayName in src/lib/conversations.ts).
model Conversation {
  id      String  @id @default(cuid())
  isGroup Boolean @default(false)
  name    String?
  // A group's photo (served path, e.g. "/media/xyz.jpg") — any participant
  // may set/change it, same flat permission as removing a member. Never set
  // for a 1:1 conversation (the GroupIcon/other participant's avatar covers
  // that instead).
  photo   String?

  // Legacy 1:1 columns from before groups existed — superseded by
  // ConversationParticipant below and no longer written to. Kept (nullable)
  // only so scripts/backfill-conversation-participants.js can read existing
  // conversations' participants once after this deploy; safe to drop in a
  // later cleanup once that backfill has run everywhere.
  userOneId String?
  userOne   User?   @relation("ConversationsAsUserOne", fields: [userOneId], references: [id])
  userTwoId String?
  userTwo   User?   @relation("ConversationsAsUserTwo", fields: [userTwoId], references: [id])

  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

// One row per (conversation, member) — replaces the old fixed
// userOneId/userTwoId columns so a conversation can have any number of
// participants, not just exactly two.
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  // Set when this participant swipes a conversation out of their own inbox
  // (see DELETE /api/conversations/[id]) — hides it from their /messages
  // list without affecting anyone else or deleting any data. Cleared
  // implicitly: the inbox query only treats it as hidden while no message
  // has arrived since, so the thread quietly resurfaces if the conversation
  // picks back up.
  hiddenAt DateTime?

  // Set when this participant was added to an existing group and chose not
  // to be shown messages from before they joined (see POST
  // /api/conversations/[id]/participants) — the thread then only loads
  // messages from joinedAt onward for them specifically, same data for
  // everyone else.
  hideHistory Boolean @default(false)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  text String

  // A GIF attached to the message (its direct media URL from the GIF
  // provider — see src/lib/tenor.ts) — not re-hosted, just linked. A message
  // can be GIF-only (see messageSchema's refine in src/lib/validation.ts).
  gifUrl String?

  // An uploaded photo/video (see src/lib/uploads.ts) — mutually exclusive
  // with each other and with gifUrl, but either can carry `text` too as a
  // caption, unlike a GIF message.
  photo          String?
  video          String?
  videoThumbnail String?

  // Set when this message is a WhatsApp-style quote-reply to another message
  // in the same conversation. SetNull (not Cascade) since messages are
  // soft-deleted in place (see deletedAt below), not actually removed — this
  // only matters if a message is ever hard-deleted some other way.
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  // Set when this message is a reply to (or a quick-reaction on) someone's
  // story (see /api/stories/[id]/reply) — Instagram's "story replies land in
  // your DMs" behavior. SetNull, not Cascade: the message (and its text/
  // emoji) stays in the conversation even once the story itself is gone,
  // same reasoning as replyToId above; the UI just stops being able to show
  // the original story's thumbnail or let you reopen it.
  storyId String?
  story   Story?  @relation(fields: [storyId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  // Set when the sender edits the text after sending.
  editedAt  DateTime?
  // Set when the sender deletes the message — text is replaced with a
  // placeholder rather than the row being removed, so the thread's shape
  // (and everyone else's scroll position/read state) doesn't shift, same
  // pattern as Comment/EventNoticeComment soft-deletion.
  deletedAt DateTime?
  readAt    DateTime?

  reactions MessageReaction[]

  @@index([conversationId])
}

// An emoji reaction (see REACTION_EMOJIS in src/lib/validation.ts) on a
// direct message — same shape as CommentReaction. No Notification row: DMs
// already have their own unread-tracking (Message.readAt), not the
// Notification feed, so a reaction surfaces the same way a new message does.
model MessageReaction {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  emoji     String

  createdAt DateTime @default(now())

  @@unique([userId, messageId, emoji])
  @@index([messageId])
}

model Event {
  id String @id @default(cuid())

  name String
  date DateTime // the event's start date/time

  // Set only for an event that runs across more than one day — null means
  // a single-day event (display code should treat null as "same as date").
  endDate DateTime?

  // True for an event with no physical venue — location is null in that
  // case, and never geocoded/distance-filtered.
  isOnline Boolean @default(false)
  location String? // required unless isOnline (see eventSubmissionSchema)

  description String? // free text "event information" — required for a user submission, optional for a curated listing
  tag         String? // free text, e.g. "Team size: 3", "Charity", "RX division"
  photo       String? // served path, e.g. "/media/xyz.jpg" (see src/lib/uploads.ts) — the event's image
  websiteUrl  String? // link to the event's own site

  // JSON-encoded arrays of EventDivision/EventTeamFormat/EventGenderCategory
  // values (see the enum comment above) — each required (min 1) for a user
  // submission, via the eventSubmissionSchema in src/lib/validation.ts.
  division       String?
  teamFormat     String?
  genderCategory String?

  // Geocoded from `location` (see src/lib/geocode.ts), lazily on first read,
  // so Discover can filter by distance from the athlete's own area.
  lat Float?
  lng Float?

  // Curated listings (added directly, e.g. via Prisma Studio or the
  // backfill scripts) are created APPROVED and createdById is just
  // bookkeeping for whichever account performed that action, not a real
  // author. A user submission (source "user_submission") is created
  // PENDING with createdById/submittedById both set to the real submitter,
  // and only shows up in Discover once a moderator approves it. A private
  // submission (isPrivate) skips review entirely — it's created APPROVED
  // straight away, since it's never publicly listed regardless of status.
  status EventStatus @default(APPROVED)

  // A private event never appears in Discover/search and needs no admin
  // review — only its creator and whoever's invited (see EventInvite) or
  // already joined can see it at all. Meant for casual social meetups and
  // gym-only ("in-affiliate") competitions rather than public listings.
  isPrivate Boolean @default(false)

  // What kind of event this is — OTHER pairs with eventKindOther for free
  // text, same pattern as User.affiliateGym/affiliateGymOther. Nullable
  // since curated/legacy listings predate this field.
  eventKind      EventKind?
  eventKindOther String?

  // The group conversation used by "Message attendees" (private events only,
  // organizer-only action — see /api/events/[id]/message-attendees). Not a
  // foreign key (same as Report.targetId) so the event doesn't depend on the
  // conversation ever existing; null until the organizer messages attendees
  // for the first time.
  attendeesConversationId String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  submittedById String?
  submittedBy   User?   @relation("EventSubmissions", fields: [submittedById], references: [id], onDelete: SetNull)

  // "manual" for a curated listing, "user_submission" for one submitted
  // in-app; an aggregator name (compete-zone/etc.) once Tier 2 partnered
  // event feeds exist.
  source String @default("manual")

  createdAt DateTime @default(now())

  participants   EventParticipant[]
  interests      EventInterest[]
  pins           EventPin[]
  notices        EventNotice[]
  posts          Post[]
  notifications  Notification[]
  teammateAlerts EventTeammateAlert[]
  invites        EventInvite[]
  workoutPhotos  EventWorkoutPhoto[]

  @@index([date])
}

// An invitation to a private event — the invitee can see and join the event
// (see /api/events/[id]/participate) once invited, even before they do.
// Individually-picked invitees and bulk ones (e.g. "everyone who follows me"
// or "everyone at gym X" — see src/lib/eventInvites.ts) end up as the same
// kind of row here; there's no record of which bulk criteria produced it.
model EventInvite {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation("EventInvitesReceived", fields: [userId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("EventInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model EventParticipant {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([eventId])
}

// "I'm interested" (looking for a team) is tracked separately from actually
// participating — marking interest auto-posts a notice on the event's board
// (see EventNotice) and un-marking it removes that same notice, without
// touching any notices the athlete wrote by hand.
model EventInterest {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  noticeId String?      @unique
  notice   EventNotice? @relation(fields: [noticeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([eventId])
}

// Pins an event to the top of "My Events" — independent of participating or
// interested status, so pinning survives switching between the two.
model EventPin {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([eventId])
}

// A lightweight classified-ads board scoped to one event — separate from the
// main feed so "looking for teammates for FORTIOR 4" posts don't clutter
// everyone's feed and stay easy to find by anyone eyeing that event.
model EventNotice {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Required for a plain free-text notice; optional extra detail alongside
  // teammateRequests.
  text String?

  // An optional attached image — e.g. the organizer sharing a poster of the
  // released competition workouts. Served path (see src/lib/uploads.ts),
  // same as every other photo field.
  photo String?

  // JSON-encoded array of teammate requests posted together for this event,
  // e.g. [{"quantity":1,"gender":"MALE","division":"RX"},{"quantity":1,"gender":"FEMALE","division":"RX"}]
  // — multiple athletes needed for the same event stay one feed post rather
  // than being split across several. Null for a plain free-text notice.
  teammateRequests String?

  createdAt DateTime @default(now())

  // Set when this notice is the auto-generated one behind an "I'm
  // interested" mark (see EventInterest.noticeId) — null for a notice
  // someone wrote by hand.
  interest EventInterest?

  likes    EventNoticeLike[]
  comments EventNoticeComment[]

  @@index([eventId])
}

// A photo in an event's "Workouts" carousel (see its own page section) —
// e.g. a poster of the released competition workouts. Deliberately separate
// from EventNotice: this is the event's own curated gallery, not a chat
// message, so it's added/removed by the organizer rather than appearing in
// the Notice Board feed.
model EventWorkoutPhoto {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  photo String // served path (see src/lib/uploads.ts)

  createdAt DateTime @default(now())

  @@index([eventId])
}

// A saved "find a team" search — lets someone with no current matches get
// notified the moment a team posts a request that fits (TEAMMATE_REQUEST_MATCH),
// and immediately notifies the reverse direction too: any team whose existing
// request already matches this alert (TEAMMATE_SEARCH_MATCH), so both sides
// of a fit hear about each other without waiting for the other to search.
model EventTeammateAlert {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // TeammateGenderOption/TeammateDivisionOption from src/lib/validation.ts,
  // including "ANY" — same matching semantics as EventNotice.teammateRequests.
  gender   String
  division String

  createdAt DateTime @default(now())

  @@unique([eventId, userId, gender, division])
  @@index([eventId])
}

model EventNoticeLike {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  noticeId String
  notice   EventNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, noticeId])
  @@index([noticeId])
}

model EventNoticeComment {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  noticeId String
  notice   EventNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  // One level of self-reference, same as Comment — a reply to a reply is
  // flattened under its top-level ancestor in the UI.
  parentId String?
  parent   EventNoticeComment?  @relation("EventNoticeCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  EventNoticeComment[] @relation("EventNoticeCommentReplies")

  text String

  createdAt DateTime @default(now())

  @@index([noticeId])
  @@index([parentId])
}

model Block {
  id String @id @default(cuid())

  blockerId String
  blocker   User   @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String
  blocked   User   @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Mute {
  id String @id @default(cuid())

  userId String
  user   User   @relation("MutesMade", fields: [userId], references: [id], onDelete: Cascade)

  mutedUserId String
  mutedUser   User   @relation("MutesReceived", fields: [mutedUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, mutedUserId])
  @@index([mutedUserId])
}

// A 24-hour ephemeral photo/video post (see src/lib/stories.ts), shown in a
// horizontal bar above the feed — same idea as Instagram Stories. Expired
// rows are never actively deleted, just filtered out by `expiresAt` in every
// story-reading query (same "let old rows sit there" pattern as messages);
// only an early, explicit delete by the author removes one.
model Story {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  photo          String? // served path, e.g. "/media/xyz.jpg" (see src/lib/uploads.ts)
  video          String?
  videoThumbnail String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  views   StoryView[]
  replies Message[]

  @@index([userId, expiresAt])
}

// One viewer having seen one story — powers both the "seen" ring state on
// the stories bar and the author-only "who's viewed this" list.
model StoryView {
  id      String @id @default(cuid())
  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  viewerId String
  viewer   User   @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([storyId])
}

model Notification {
  id String @id @default(cuid())

  // Who sees this notification.
  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  // Who did the thing that triggered it.
  actorId String
  actor   User   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  type NotificationType

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Set for REPLY/COMMENT_LIKE, and for MENTION when the mention was inside
  // a comment rather than the post body itself.
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // Set for EVENT_SUBMITTED — the event awaiting review.
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Set for GYM_SUBMITTED — the gym awaiting review.
  gymId String?
  gym   Gym?    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  // Set for SYSTEM_ANNOUNCEMENT — the notice being broadcast (title/body live
  // there, shared across every recipient's Notification row).
  noticeId String?
  notice   Notice? @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  // Set for WORKOUT_COMMENT — the workout commented on, so the notification
  // can deep-link straight to it (see /profile/[userId]/gallery?workout=).
  workoutId String?
  workout   Workout? @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  // Set for PB_COMMENT — which PB_FIELDS entry was commented on (e.g.
  // "backSquatKg"), so the notification can name it and deep-link to it (see
  // /profile/[userId]/pbs?field=). Not a relation — a PB is just a field on
  // User, not its own row.
  pbField String?

  // Set for STATUS_REACTION/COMMENT_REACTION — which of the fixed
  // REACTION_EMOJIS was used, so the notification can say which one instead
  // of just "reacted".
  emoji String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([noticeId])
}

// A broadcast message from Box 2 Box itself, sent to an admin-chosen
// audience (see /admin/notices and /api/admin/notices). Each recipient gets
// their own Notification row (type SYSTEM_ANNOUNCEMENT, noticeId pointing
// here) — this row is the shared content, not a per-recipient copy.
model Notice {
  id String @id @default(cuid())

  title String
  body  String

  sentById String
  sentBy   User   @relation("NoticesSent", fields: [sentById], references: [id], onDelete: Cascade)

  // Audience filters applied at send time — all optional, null meaning "no
  // restriction on this dimension". Kept only as a record of who this went
  // to; recipients are the Notification rows below, never re-derived from
  // these later (so the audience shown here can't drift from who actually
  // got it, even if e.g. a user's gym changes afterwards).
  audienceGender       Gender?
  audienceMinAge       Int?
  audienceMaxAge       Int?
  audienceLevel        Level?
  audienceAffiliateGym String?
  audienceCountry      String?
  audienceAreaQuery    String?
  audienceRadiusMiles  Int?

  recipientCount Int @default(0)

  createdAt DateTime @default(now())

  notifications Notification[]

  @@index([sentById])
}

enum ReportTargetType {
  USER
  POST
  COMMENT
  MESSAGE
  EVENT_NOTICE
  EVENT_NOTICE_COMMENT
  WORKOUT_COMMENT
  PB_COMMENT
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  NUDITY
  VIOLENCE
  SELF_HARM
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  OPEN
  // Reviewed, no action needed.
  DISMISSED
  // Content removed and/or its author suspended.
  ACTIONED
}

// A user flagging another user, or something they posted, for an admin to
// review at /reports/review. targetId points at a row of the table named by
// targetType — deliberately not a foreign key, so the report (and its
// snapshot) survives the content being deleted. contentSnapshot records what
// the content said at report time, so an edit afterwards can't hide it from
// the reviewer.
model Report {
  id String @id @default(cuid())

  reporterId String
  reporter   User   @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  // Whoever owns the reported content (or the reported user themselves).
  reportedUserId String
  reportedUser   User   @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)

  targetType ReportTargetType
  targetId   String

  reason  ReportReason
  details String?

  contentSnapshot String?
  // Served path of an attached photo/video at report time, if any.
  mediaSnapshot   String?

  status     ReportStatus @default(OPEN)
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  // Reporting the same thing twice updates the existing report rather than
  // piling up duplicates in the review queue.
  @@unique([reporterId, targetType, targetId])
  @@index([status])
  @@index([targetType, targetId])
}

enum GymStatus {
  PENDING
  APPROVED
  REJECTED
}

// A details page for an affiliate gym shown in Discover's Affiliates tab.
// The fixed gyms in src/lib/gyms.ts (AFFILIATE_GYMS) are curated — added
// directly (e.g. via Prisma Studio), created APPROVED, "name" matching
// User.affiliateGym's string exactly. Anyone can also submit a gym that
// isn't in that fixed list via /gyms/submit, same review flow as Event: PENDING
// until a moderator approves it, and never selectable as a profile's
// affiliateGym (that dropdown stays the fixed list) — this is purely a
// browsable directory entry.
model Gym {
  id String @id @default(cuid())

  name        String  @unique
  description String?
  address     String?
  website     String?
  photo       String? // served path, e.g. "/media/xyz.jpg" (see src/lib/uploads.ts)

  // Geocoded from `address` (see src/lib/geocode.ts), lazily on first read,
  // so Discover's Affiliates tab can filter by distance from the athlete's
  // own area.
  lat Float?
  lng Float?

  // Where a "Book an Intro Session"/"Book a Drop-in" tap on this gym's page
  // goes. Null (the default) means it's routed as an in-app message to the
  // verified AFFILIATE account running this gym (see findVerifiedGymOwner in
  // src/lib/gymPages.ts); set means it opens the requester's email client
  // addressed here instead. Only a verified affiliate can set this (see
  // /api/gyms/[id]/book's PATCH) so an unverified account can't hijack an
  // established gym's booking requests.
  bookingEmail String?

  status GymStatus @default(APPROVED)

  submittedById String?
  submittedBy   User?   @relation("GymSubmissions", fields: [submittedById], references: [id], onDelete: SetNull)

  // The AFFILIATE profile that's been verified (see User.verifiedAt) as
  // actually running this gym — set automatically the moment an admin
  // approves their verification request, if its affiliateGym matches this
  // row's name (see /api/admin/verification-requests/[id]). Once set,
  // Discover and this gym's own page show that profile's live photo and
  // link to it, instead of only the static seed/admin-entered details, so
  // there's one representation of the gym rather than a static page and a
  // real profile competing. Cleared (not left dangling) if that profile's
  // account is ever deleted — see /api/account/delete.
  claimedById String? @unique
  claimedBy   User?   @relation("GymClaim", fields: [claimedById], references: [id], onDelete: SetNull)

  // "manual" for a curated listing, "user_submission" for one submitted in-app.
  source String @default("manual")

  createdAt DateTime @default(now())

  notifications Notification[]
}
